digraph G { graph [rankdir=TB, nodesep=0.55, ranksep=1.0, splines=true, overlap=false, fontname="DejaVu Sans", bgcolor="white", pad=0.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=10]; edge [fontname="DejaVu Sans", fontsize=9, color="#374151"];
labelloc=t; label=<<B><FONT POINT-SIZE="20">Class Diagram - Food Delivery Management System</FONT></B>>;
Record [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e0f2fe" COLOR="#0369a1"><TR><TD><I>Record</I></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># id : int</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getId() : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setId(newId : int)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ display() : void {abstract}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ row() : string {abstract}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ summary() : string {abstract}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ toFileLine() : string {abstract}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ typeName() : string {abstract}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ~Record() {virtual}</TD></TR></TABLE>>];
Person [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e0f2fe" COLOR="#0369a1"><TR><TD><I>Person</I></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># name : string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># phone : string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># address : string</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getName() / getPhone() / getAddress()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setName(v) / setPhone(v) / setAddress(v)  (validated)</TD></TR></TABLE>>];
Customer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff7ed" COLOR="#c2410c"><TR><TD><B>Customer</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- loyaltyPoints : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- ordersPlaced : int</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addPoints(pts : int)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ incrementOrders()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ tier() : string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ display() / row() / summary()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ toFileLine() : string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ fromFileLine(line) : Customer {static}</TD></TR></TABLE>>];
DeliveryAgent [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff7ed" COLOR="#c2410c"><TR><TD><I>DeliveryAgent</I></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># available : bool</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># rating : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># deliveriesDone : int</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calculateFee(km : double) : double {abstract}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ travelMinutes(km : double) : double {abstract}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ vehicleCode() : char {abstract}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ vehicleName() : string {abstract}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ recordDelivery(rating : int)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ isAvailable() / setAvailable(v)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(code, ...) : DeliveryAgent* {static}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ fromFileLine(line) : DeliveryAgent* {static}</TD></TR></TABLE>>];
BikeAgent [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff7ed" COLOR="#c2410c"><TR><TD><B>BikeAgent</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calculateFee(km) : double   // Rs.20 + 6/km</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ travelMinutes(km) : double // 22 km/h</TD></TR></TABLE>>];
ScooterAgent [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff7ed" COLOR="#c2410c"><TR><TD><B>ScooterAgent</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calculateFee(km) : double   // Rs.25 + 8/km</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ travelMinutes(km) : double // 28 km/h</TD></TR></TABLE>>];
CarAgent [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff7ed" COLOR="#c2410c"><TR><TD><B>CarAgent</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calculateFee(km) : double   // Rs.40 + 12/km</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ travelMinutes(km) : double // 35 km/h</TD></TR></TABLE>>];
Route [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff7ed" COLOR="#c2410c"><TR><TD><B>Route</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- source : string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- destination : string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- distanceKm : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- trafficFactor : double</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setSource(v) / setDestination(v)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setDistanceKm(v) / setTrafficFactor(v)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ adjustedMinutes(base : double) : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ label() : string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ toFileLine() : string</TD></TR></TABLE>>];
Order [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff7ed" COLOR="#c2410c"><TR><TD><B>Order</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- customerId : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- agentId : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- routeId : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- items : string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- foodAmount : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- deliveryFee : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- etaMinutes : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- customerRating : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- status : Status</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- createdAt : string</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ assignAgent(agentId, fee, eta)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ markPickedUp()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ markDelivered(rating : int)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cancel()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ unassign()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ isActive() : bool</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getTotal() : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ toFileLine() : string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ fromFileLine(line) : Order {static}</TD></TR></TABLE>>];
DeliverySystem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dcfce7" COLOR="#15803d"><TR><TD><B>DeliverySystem</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- customers : DynArray&lt;Customer&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- agents : DynArray&lt;DeliveryAgent*&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- routes : DynArray&lt;Route&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- orders : DynArray&lt;Order&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- files : FileManager</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nextCustomerId, nextAgentId, nextRouteId, nextOrderId : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- dirty : bool</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ start() / shutdown()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addRecord() / displayRecords()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ searchRecord() / updateRecord() / deleteRecord()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ mainTransaction() / report() / saveLoadMenu()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- placeOrder() / assignPendingOrder() / pickUpOrder()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- deliverOrder() / cancelOrder() / trackOrder()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- findBestAvailableAgent() : DeliveryAgent*</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- reconcile() / recomputeIds()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- saveAll() / loadAll(announce : bool)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- buildReport() : string</TD></TR></TABLE>>];
FileManager [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dcfce7" COLOR="#15803d"><TR><TD><B>FileManager</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- dataDir : string</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ saveCustomers(list) / saveAgents(list)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ saveRoutes(list) / saveOrders(list)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ loadCustomers(list) : LoadResult</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ loadAgents(list) : LoadResult</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ loadRoutes(list) / loadOrders(list)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ writeText(file, content)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ locateDataDir() : string {static}</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- writeLines(...) / readLines(...)</TD></TR></TABLE>>];
DynArray [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f3e8ff" COLOR="#7e22ce"><TR><TD><FONT POINT-SIZE="9">&lt;&lt;template&gt;&gt;</FONT></TD></TR><TR><TD><B>DynArray&lt;T&gt;</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- data_ : T*</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- size_ : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- capacity_ : int</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ add(value : T)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ removeAt(index : int)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ operator[](index : int) : T&amp;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ size() / capacity() / clear()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- grow()  // new T[2n], copy, delete[]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ~DynArray()  // delete[] data_</TD></TR></TABLE>>];
Utils [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f3f4f6" COLOR="#4b5563"><TR><TD><FONT POINT-SIZE="9">&lt;&lt;exception hierarchy&gt;&gt;</FONT></TD></TR><TR><TD><B>Exceptions</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">AppException : runtime_error</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">  +- ValidationException</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">  +- NotFoundException</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">  +- OperationException</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">  +- FileException</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">InputEnded : exception</TD></TR></TABLE>>];
Record -> Person [dir=back, arrowtail=onormal, arrowsize=1.1];
Record -> Route [dir=back, arrowtail=onormal, arrowsize=1.1];
Record -> Order [dir=back, arrowtail=onormal, arrowsize=1.1];
Person -> Customer [dir=back, arrowtail=onormal, arrowsize=1.1];
Person -> DeliveryAgent [dir=back, arrowtail=onormal, arrowsize=1.1];
DeliveryAgent -> BikeAgent [dir=back, arrowtail=onormal, arrowsize=1.1];
DeliveryAgent -> ScooterAgent [dir=back, arrowtail=onormal, arrowsize=1.1];
DeliveryAgent -> CarAgent [dir=back, arrowtail=onormal, arrowsize=1.1];
DeliverySystem -> Customer [dir=back, arrowtail=diamond, arrowsize=1.1, headlabel="0..*", labeldistance=1.8, taillabel="1"];
DeliverySystem -> DeliveryAgent [dir=back, arrowtail=diamond, arrowsize=1.1, headlabel="0..*", labeldistance=1.8, taillabel="1"];
DeliverySystem -> Route [dir=back, arrowtail=diamond, arrowsize=1.1, headlabel="0..*", labeldistance=1.8, taillabel="1"];
DeliverySystem -> Order [dir=back, arrowtail=diamond, arrowsize=1.1, headlabel="0..*", labeldistance=1.8, taillabel="1"];
DeliverySystem -> FileManager [dir=back, arrowtail=diamond, arrowsize=1.1, headlabel="1", taillabel="1", labeldistance=1.6];
DeliverySystem -> DynArray [style=dashed, arrowhead=open, xlabel="uses"];
Order -> Customer [arrowhead=vee, style=solid, xlabel="placed by", constraint=false, color="#b45309", fontcolor="#b45309"];
Order -> DeliveryAgent [arrowhead=vee, xlabel="delivered by", constraint=false, color="#b45309", fontcolor="#b45309"];
Order -> Route [arrowhead=vee, xlabel="uses", constraint=false, color="#b45309", fontcolor="#b45309"];
FileManager -> Record [arrowhead=open, style=dashed, xlabel="reads / writes", constraint=false, color="#4b5563"];
{rank=same; DeliverySystem; FileManager; DynArray;}
{rank=same; Person; Route; Order;}
{rank=same; Customer; DeliveryAgent;}
{rank=same; BikeAgent; ScooterAgent; CarAgent; Utils;}
}